# ---- Пути на хосте ----
ARCHIVE_PATH=./data/archive        # архив: incoming/ raw/ thumbs/ proxies/ quarantine/ exports/ tmp/
PGDATA_PATH=./data/pgdata
HTTP_PORT=8080

# ---- PostgreSQL ----
POSTGRES_USER=tsa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tsarchive

# ---- Образы (для изолированной сети укажите Nexus) ----
# APP_IMAGE=nexus.local:5000/ts-archive:1.0.0
# POSTGRES_IMAGE=nexus.local:5000/postgres:16-alpine
# NGINX_IMAGE=nexus.local:5000/nginx:1.27-alpine
MEDIA_WORKERS=2

# ---- Приём ----
# Структура: incoming/{техника}/{камера}/[подкаталоги/]YYYYMMDD_HHMMSS[_mmm]*.ts
# FILENAME_REGEX=^(?P<vehicle>[^/]+)/(?P<camera>[^/]+)/(?:.*/)?(?P<ts>\d{8}[_T-]?\d{6}(?:[_.]\d{1,6})?)[^/]*\.ts$
FILENAME_TZ=Europe/Moscow          # часовой пояс времени в именах файлов
INGEST_STABLE_SECONDS=30           # файл ~80 МБ не менялся N секунд — загрузка завершена
INGEST_DELETE_DUPLICATES=1

# ---- Группировка в сегменты ----
GAP_THRESHOLD_SEC=3                # разрыв больше — новый сегмент
OVERLAP_TOLERANCE_SEC=1
SEGMENT_MAX_SEC=3600               # максимальная длина сегмента (час = ~20 файлов по 80 МБ)
IDLE_CLOSE_SEC=600                 # нет новых файлов N секунд (не меньше 2× длительности файла) — закрыть сегмент

# ---- Воспроизведение исходных TS (HLS byte-range, склеенных копий нет) ----
HLS_CHUNK_SEC=6                    # длина куска плейлиста (по ключевым кадрам)
PAT_SEARCH_BYTES=1048576           # поиск PAT/PMT перед ключевым кадром при индексации
PLAYLIST_CACHE_SEC=60

# ---- Прокси и выгрузки ----
PROXY_TRANSCODE=auto               # auto | never | always — прокси H.264 только для MPEG-2 Video и др.
BROWSER_CODECS=h264,hevc           # HEVC: hls.js разбирает, декодирует браузер (Chrome/Edge/Safari с аппаратной поддержкой)
AUDIO_MODE=auto                    # выгрузки MP4: AAC/MP3 копируются, G.711 → AAC | drop
THUMB_INTERVAL_SEC=15
PROBE_THREADS=4
FFMPEG_TIMEOUT=3600

# ---- Хранение ----
EXPORT_TTL_HOURS=24
EXPORT_MAX_SEC=3600

# ---- Разметка «человек в кадре» (worker-detect) ----
DETECT_IMAGE=ts-archive-detect:latest
MODELS_PATH=./models                # tools/get_models.sh кладёт сюда yolox_s.onnx, yolox_tiny.onnx
DETECT_MODEL=/models/yolox_s.onnx   # после quantize: /models/yolox_s_int8.xml (в ~2 раза быстрее на Xeon с VNNI)
DETECT_DECODED=0                    # 1 — модель экспортирована с --decode_in_inference
DETECT_CLASSES=person               # классы COCO через запятую: person,car,truck
DETECT_FPS=2                        # кадров в секунду на анализ; нагрузка растёт линейно
DETECT_CONF=0.45                    # порог уверенности (на камере можно переопределить min_conf)
DETECT_NMS=0.45
DETECT_MIN_HEIGHT=0.03              # рамки ниже 3% высоты кадра отбрасываются
DETECT_GAP_SEC=3                    # пауза, которая не разрывает интервал
DETECT_MIN_DUR_SEC=1
DETECT_MIN_HITS=2
DETECT_DEVICE=CPU
DETECT_HINT=THROUGHPUT              # THROUGHPUT — архив; LATENCY — если важна задержка одного кадра
DETECT_CPUS=12                      # лимит CPU контейнера; на 16 vCPU оставьте 4 под БД, API, ingest/media
DETECT_THREADS=12                   # потоки OpenVINO = DETECT_CPUS, иначе квота CPU будет «душить» лишние потоки
DETECT_STREAMS=                     # пусто — подбирает OpenVINO
DETECT_DECODE_THREADS=2             # потоки FFmpeg на декодирование H.264
DETECT_THUMB_WIDTH=320

# ---- Проверка каски (второй шаг detect; выключена, если файла модели нет) ----
HELMET_MODEL=/models/helmet_cls.onnx  # в комплекте; переобучение — tools/train_helmet.py
HELMET_NO_THRESH=0.7               # p(без каски) ≥ — «без каски»; выше — меньше ложных тревог, больше пропусков
HELMET_YES_THRESH=0.6              # p(каска) ≥ — «в каске»; между порогами — «не определено»
HELMET_MIN_HEAD_PX=14              # голова меньше (пиксели исходного кадра) не проверяется
HELMET_MIN_HITS=3                  # минимум кадров «без каски» в интервале (при 2 кадр/с ≈ 1,5 с)
HELMET_MAX_WIDTH=1920              # кадр для вырезки голов, не шире
HELMET_THREADS=2
HELMET_SCALES=1,1.4                # масштабы квадрата головы, вероятности усредняются
# Режим проверки касок: auto — детектор голов, если есть модель, иначе квадрат головы + классификатор
HELMET_MODE=auto                   # auto | heads | crop | off
HEADS_MODEL=/models/heads_nano.onnx  # в комплекте; переобучение — tools/train_heads.py
HEADS_CONF=0.4                     # голова «в каске» — от этой уверенности
HEADS_NO_CONF=0.5                  # голова «без каски» — от этой уверенности
HEADS_ALONE_CONF=0.5               # голова без рамки человека считается человеком
HEADS_MIN_PX=6                     # сторона головы во входе 640, минимум
HEADS_ALL_FRAMES=1                 # искать головы и в кадрах без найденных людей

LOG_LEVEL=INFO
